# Browser-visible values only. Never put PartyKit, Cloudflare, or LiveKit secrets
# in a VITE_* variable; Vite embeds these values in the static client bundle.
VITE_PUBLIC_ORIGIN=https://liminal.example
VITE_PARTY_HOST=liminal.example-account.partykit.dev

# Optional cookieless product analytics. Both values are required when enabled.
# Enable "Cookieless server hash mode" and disable IP capture in PostHog project settings.
VITE_POSTHOG_KEY=phc_your_public_project_token
VITE_POSTHOG_HOST=https://eu.i.posthog.com
